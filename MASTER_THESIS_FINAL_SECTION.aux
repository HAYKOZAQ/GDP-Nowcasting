\newlabel{tab:shock_quarter_results}{{10}{17}{Selected crisis-quarter absolute percentage errors (\%). Abbreviations: AdaEns = \texttt {AdaptiveEnsemble}, ENet = \texttt {ElasticNet}, DFM-SA = \texttt {DFMShockAdjusted}, ESA = \texttt {EarlyShockAdjusted}}{table.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Evolution of the 2020 Q2 nowcast across the quarter. This is the central crisis-quarter figure in the thesis because it shows how forecast accuracy changes between \textit  {Early}, \textit  {Mid}, and \textit  {Late} as new information arrives.}}{17}{figure.3}\protected@file@percent }
\newlabel{fig:focus_2020q2}{{3}{17}{Evolution of the 2020 Q2 nowcast across the quarter. This is the central crisis-quarter figure in the thesis because it shows how forecast accuracy changes between \textit {Early}, \textit {Mid}, and \textit {Late} as new information arrives}{figure.3}{}}
