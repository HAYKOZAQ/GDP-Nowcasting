\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Benchmark accuracy across the three information stages. The figure shows that model ranking is stage-dependent: regularized linear models dominate in the sparse-information \textit  {Early} stage, while combination models dominate once the information set becomes richer.}}{14}{figure.1}\protected@file@percent }
\newlabel{fig:stage_mape}{{1}{14}{Benchmark accuracy across the three information stages. The figure shows that model ranking is stage-dependent: regularized linear models dominate in the sparse-information \textit {Early} stage, while combination models dominate once the information set becomes richer}{figure.1}{}}
