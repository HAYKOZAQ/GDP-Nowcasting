\newlabel{tab:model_interpretation_detail}{{11}{19}{Interpretation of the main benchmark models}{table.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Bias profile of selected benchmark models by stage. Positive residuals indicate underprediction and negative residuals indicate overprediction because the residual is defined as actual minus prediction. The figure is useful for identifying which models fail because they are too optimistic and which fail because they react too slowly to new information.}}{21}{figure.4}\protected@file@percent }
\newlabel{fig:bias_profile}{{4}{21}{Bias profile of selected benchmark models by stage. Positive residuals indicate underprediction and negative residuals indicate overprediction because the residual is defined as actual minus prediction. The figure is useful for identifying which models fail because they are too optimistic and which fail because they react too slowly to new information}{figure.4}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {1.6.7}Forecast Revision Dynamics}{21}{subsubsection.1.6.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Ensemble-style spaghetti chart for Armenian GDP nowcasting. Thin gray lines show individual model-stage nowcasts across target quarters, while the highlighted lines show the ensemble mean, the \texttt  {AdaptiveEnsemble} paths by information stage, the realized GDP path, and the sample mean. The figure illustrates both the dispersion of model-based nowcasts and the way forecasts cluster around the realized GDP trajectory outside the most difficult shock quarters.}}{22}{figure.5}\protected@file@percent }
\newlabel{fig:spaghetti_nowcast}{{5}{22}{Ensemble-style spaghetti chart for Armenian GDP nowcasting. Thin gray lines show individual model-stage nowcasts across target quarters, while the highlighted lines show the ensemble mean, the \texttt {AdaptiveEnsemble} paths by information stage, the realized GDP path, and the sample mean. The figure illustrates both the dispersion of model-based nowcasts and the way forecasts cluster around the realized GDP trajectory outside the most difficult shock quarters}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Best-performing model by stage across the full sample. The figure shows the realized GDP path against the winning specification in \textit  {Early}, \textit  {Mid}, and \textit  {Late}. This makes the stage-dependent nature of the final system visually explicit.}}{23}{figure.6}\protected@file@percent }
\newlabel{fig:stage_winners}{{6}{23}{Best-performing model by stage across the full sample. The figure shows the realized GDP path against the winning specification in \textit {Early}, \textit {Mid}, and \textit {Late}. This makes the stage-dependent nature of the final system visually explicit}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Heatmap of model ranking by information stage. Lower MAPE values indicate stronger performance. The visual compactly shows that model dominance changes across stages and that no single baseline wins everywhere.}}{24}{figure.7}\protected@file@percent }
\newlabel{fig:ranking_heatmap}{{7}{24}{Heatmap of model ranking by information stage. Lower MAPE values indicate stronger performance. The visual compactly shows that model dominance changes across stages and that no single baseline wins everywhere}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Shock and non-shock accuracy by model family. The figure highlights that combination models are the most robust family overall, while structural and pure ML families are more stage-dependent under crisis conditions.}}{24}{figure.8}\protected@file@percent }
\newlabel{fig:family_shock_nonshock}{{8}{24}{Shock and non-shock accuracy by model family. The figure highlights that combination models are the most robust family overall, while structural and pure ML families are more stage-dependent under crisis conditions}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Information-set composition for 2020 Q2. The \textit  {Early} stage contains no same-quarter official monthly series, whereas the \textit  {Mid} and \textit  {Late} stages progressively incorporate richer official information.}}{25}{figure.9}\protected@file@percent }
\newlabel{fig:info_2020q2}{{9}{25}{Information-set composition for 2020 Q2. The \textit {Early} stage contains no same-quarter official monthly series, whereas the \textit {Mid} and \textit {Late} stages progressively incorporate richer official information}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Release calendar and information flow across the quarter. The figure illustrates the methodological logic of the framework: the \textit  {Early} stage relies mainly on fast indicators, while the \textit  {Late} stage benefits from a far richer official monthly information set.}}{25}{figure.10}\protected@file@percent }
\newlabel{fig:release_calendar}{{10}{25}{Release calendar and information flow across the quarter. The figure illustrates the methodological logic of the framework: the \textit {Early} stage relies mainly on fast indicators, while the \textit {Late} stage benefits from a far richer official monthly information set}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Forecast uncertainty bands for the preferred late-stage model. The 50\% and 90\% empirical intervals show that the framework produces not only point nowcasts but also uncertainty assessments.}}{26}{figure.11}\protected@file@percent }
\newlabel{fig:uncertainty_bands}{{11}{26}{Forecast uncertainty bands for the preferred late-stage model. The 50\% and 90\% empirical intervals show that the framework produces not only point nowcasts but also uncertainty assessments}{figure.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Comparison of structural, machine-learning, and combination model families. The figure shows that combination models dominate on average, which supports the choice of \texttt  {AdaptiveEnsemble} as the preferred operational specification.}}{26}{figure.12}\protected@file@percent }
\newlabel{fig:model_family}{{12}{26}{Comparison of structural, machine-learning, and combination model families. The figure shows that combination models dominate on average, which supports the choice of \texttt {AdaptiveEnsemble} as the preferred operational specification}{figure.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Actual GDP growth and the preferred late-stage operational model. The Adaptive Ensemble tracks the realized GDP series closely while remaining stable during both normal and shock periods.}}{27}{figure.13}\protected@file@percent }
\newlabel{fig:best_late_model}{{13}{27}{Actual GDP growth and the preferred late-stage operational model. The Adaptive Ensemble tracks the realized GDP series closely while remaining stable during both normal and shock periods}{figure.13}{}}
